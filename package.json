{
  "name": "vsread",
  "displayName": "VSRead · 青菜阅读",
  "icon": "media/icon.png",
  "description": "支持本地 EPUB、TXT、PDF 与在线书源，自动保存进度，让故事住进 IDE。",
  "version": "0.1.7",
  "publisher": "vsread-local",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/linkyu9319/VSRead.git"
  },
  "homepage": "https://github.com/linkyu9319/VSRead#readme",
  "bugs": {
    "url": "https://github.com/linkyu9319/VSRead/issues"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "epub",
    "pdf",
    "txt",
    "reader",
    "offline"
  ],
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onWebviewPanel:vsread.reader",
    "onView:vsread.library.launcher",
    "onCommand:vsread.open",
    "onCommand:vsread.import",
    "onCommand:vsread.sources",
    "onCommand:vsread.toggleFocusMode",
    "onCommand:vsread.openLogs",
    "onCommand:vsread.checkUpdates",
    "onCommand:vsread.configureUpdateToken",
    "onCommand:vsread.clearUpdateToken"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vsread.library",
          "title": "VSRead · 青菜阅读",
          "icon": "media/activity-reader.svg"
        }
      ]
    },
    "views": {
      "vsread.library": [
        {
          "id": "vsread.library.launcher",
          "name": "阅读入口",
          "icon": "media/activity-reader.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "vsread.open",
        "title": "VSRead: 打开阅读器",
        "icon": "$(book)"
      },
      {
        "command": "vsread.import",
        "title": "VSRead: 导入本地电子书",
        "icon": "$(add)"
      },
      { "command": "vsread.sources", "title": "VSRead: 在线书源", "icon": "$(globe)" },
      { "command": "vsread.toggleFocusMode", "title": "VSRead: 切换专注阅读", "icon": "$(screen-full)" },
      { "command": "vsread.openLogs", "title": "VSRead: 打开诊断日志", "icon": "$(output)" },
      { "command": "vsread.checkUpdates", "title": "VSRead: 检查更新", "icon": "$(versions)" },
      { "command": "vsread.configureUpdateToken", "title": "VSRead: 配置更新访问令牌" },
      { "command": "vsread.clearUpdateToken", "title": "VSRead: 清除更新访问令牌" }
    ],
    "keybindings": [
      { "command": "vsread.toggleFocusMode", "key": "ctrl+alt+h", "mac": "cmd+alt+h", "when": "vsread.readerActive" }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "vsread.import",
          "when": "resourceExtname =~ /\\.(txt|epub|pdf)$/i",
          "group": "navigation@90"
        }
      ],
      "view/title": [
        {
          "command": "vsread.open",
          "when": "view == vsread.library.launcher",
          "group": "navigation@1"
        },
        {
          "command": "vsread.import",
          "when": "view == vsread.library.launcher",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm run build && npm test",
    "package": "npm run check && vsce package --no-dependencies --allow-missing-repository --no-rewrite-relative-links --out vsread-0.1.7.vsix",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "cheerio": "1.0.0",
    "epubjs": "0.3.93",
    "iconv-lite": "^0.7.0",
    "pdfjs-dist": "6.5.438",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.27.0",
    "jszip": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
